{
  "name": "sentinel",
  "version": "2.0.0",
  "private": true,
  "description": "SENTINEL — control your PC from your phone through your own VPN and an ESP32 bridge",
  "author": "pawelaachi123-eng",
  "license": "MIT",
  "main": "desktop/main.js",
  "bin": {
    "sentinel-agent": "bin/sentinel-agent.js"
  },
  "scripts": {
    "start": "node bin/sentinel-agent.js --open",
    "agent": "node bin/sentinel-agent.js",
    "pair": "node bin/sentinel-agent.js --pair",
    "test": "node test/run.js",
    "check": "node scripts/check.js",
    "build:exe": "pkg bin/sentinel-agent.js --targets node22-win-x64 --compress GZip --output dist/SENTINEL-Agent.exe",
    "build:desktop": "electron-builder --win --x64",
    "build:all": "npm run build:exe && npm run build:desktop",
    "mobile:sync": "node scripts/sync-mobile.js"
  },
  "pkg": {
    "assets": [
      "ui/**/*",
      "package.json"
    ],
    "outputPath": "dist"
  },
  "build": {
    "appId": "io.sentinel.pc-control",
    "productName": "SENTINEL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "core/**/*",
      "ui/**/*",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "SENTINEL-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "SENTINEL-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SENTINEL"
    }
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.5.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
