{
  "name": "sentinel",
  "version": "4.0.0",
  "private": true,
  "description": "SENTINEL \u2014 your own local AI assistant that actually operates this PC, from the machine itself or from your phone over an encrypted direct channel (no cloud, no account)",
  "author": "pawelaachi123-eng",
  "license": "MIT",
  "main": "desktop/main.js",
  "bin": {
    "sentinel-agent": "bin/sentinel-agent.js",
    "sentinel": "bin/sentinel.js"
  },
  "scripts": {
    "start": "node bin/sentinel-agent.js --open",
    "agent": "node bin/sentinel-agent.js",
    "pair": "node bin/sentinel-agent.js --pair",
    "test": "node test/run.js && node test/ui.js && node test/ai.js && node test/deep.js",
    "check": "node scripts/check.js",
    "build:exe": "pkg bin/sentinel-agent.js --targets node22-win-x64 --compress GZip --output dist/SENTINEL-Agent.exe",
    "build:desktop": "electron-builder --win --x64",
    "build:all": "npm run build:exe && npm run build:desktop",
    "mobile:sync": "node scripts/sync-mobile.js",
    "test:core": "node test/run.js",
    "test:deep": "node test/deep.js",
    "test:ui": "node test/ui.js",
    "test:ai": "node test/ai.js"
  },
  "pkg": {
    "assets": [
      "ui/**/*",
      "package.json"
    ],
    "outputPath": "dist"
  },
  "build": {
    "appId": "io.sentinel.pc-control",
    "productName": "SENTINEL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "core/**/*",
      "ui/**/*",
      "build/*.png",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SENTINEL-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "SENTINEL-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SENTINEL"
    }
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.5.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^31.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
